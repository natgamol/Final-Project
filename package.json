    "test:timetable-save": "npx -y firebase-tools@latest emulators:exec --only firestore,auth --project smartlife-budget \"node --experimental-strip-types --import ./scripts/register-scan-save-test.mjs ./scripts/test-timetable-save.mjs\"",
